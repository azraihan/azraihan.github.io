<!-- Under Review papers from _data/coming_soon.yml; used on the About and Publications pages -->
<div class="publications">
  <ol class="bibliography">
    {% for paper in site.data.coming_soon %}
      <li>
        <div class="row">
          <div class="col col-sm-2 abbr">
            <abbr class="badge rounded w-100">Under Review</abbr>
            {% if paper.preview %}
              {% assign preview_path = paper.preview | prepend: '/assets/img/publication_preview/' %}
              {%
                include figure.liquid
                loading="eager"
                path=preview_path
                sizes = "200px"
                class="preview z-depth-1 rounded"
                zoomable=true
                avoid_scaling=true
                alt=paper.preview
              %}
            {% endif %}
          </div>
          <div class="col-sm-8">
            <div class="title">{{ paper.title }}</div>
            {% if paper.authors %}
              <div class="author">{{ paper.authors }}</div>
            {% endif %}
            {% if paper.note %}
              <div class="periodical">{{ paper.note }}</div>
            {% endif %}
            <div class="links">
              <a class="abstract btn btn-sm z-depth-0" role="button">Abstract</a>
            </div>
            <div class="abstract hidden">
              <p>{{ paper.abstract }}</p>
            </div>
          </div>
        </div>
      </li>
    {% endfor %}
  </ol>
</div>
